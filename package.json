{
  "name": "pyxis-api",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first product analytics API: event ingestion, dashboard queries and LGPD erasure.",
  "license": "MIT",
  "author": "Samuel Santana",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelcsantana/pyxis-api.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "start:watch": "node --watch dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:cov": "npm test -- --coverage",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config test/jest-e2e.json",
    "lint": "eslint . --max-warnings 0 && node scripts/check-no-comments.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:tooling": "node --test \"eslint-rules/**/*.test.mjs\" \"scripts/**/*.test.mts\"",
    "openapi:export": "npm run build && node dist/export-openapi.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "fastify": "^5.12.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts",
      "!export-openapi.ts",
      "!**/*.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    },
    "workerIdleMemoryLimit": "1GB"
  },
  "lint-staged": {
    "*.{ts,mts,mjs}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "src/**/*.ts": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --bail --findRelatedTests --passWithNoTests",
    "*.{json,yml,yaml,md}": "prettier --check"
  }
}
